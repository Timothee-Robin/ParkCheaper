# ==============================================================================
# PayByPhone Buyer - .gitignore
# ==============================================================================

# Credentials & Secrets (CRITICAL - NEVER COMMIT)
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# PyInstaller & Build Outputs
build/
dist/
*.manifest
*.spec.bak

# WiX Toolset & Installers
.tools/
*.wixobj
*.wixpdb
*.msi
*.exe

# Node / Frontend
node_modules/
**/node_modules/
frontend/dist/
frontend/.vite/
frontend/.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# Logs & Databases
*.log
logs/
*.sqlite
*.sqlite3
*.db

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Settings
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Testing & Coverage
.coverage
.coverage.*
.pytest_cache/
htmlcov/
.mypy_cache/
.ruff_cache/